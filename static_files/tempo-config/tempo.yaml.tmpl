server:
  http_listen_port: {{ .HTTPPort }}

distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: 0.0.0.0:{{ .OTLPGRPCPort }}
{{- if .TempoMTLSEnabled }}
          tls:
            cert_file: {{ .TempoServerCertPath }}
            key_file: {{ .TempoServerKeyPath }}
            client_ca_file: {{ .TempoClientCAPath }}
{{- end }}
        http:
          endpoint: 0.0.0.0:{{ .OTLPHTTPPort }}

ingester:
  trace_idle_period: 10s
  max_block_duration: 5m

compactor:
  compaction:
    block_retention: {{ .RetentionDuration }}

storage:
  trace:
    backend: local
    wal:
      path: /tmp/tempo/wal
    local:
      path: /tmp/tempo/traces

stream_over_http_enabled: true
